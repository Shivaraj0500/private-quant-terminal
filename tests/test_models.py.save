from datetime import datetime

from private_quant_terminal.models import (
    Candle,
    Instrument,
    Instr6cd '/workspaces/private-quant-terminal'
    Order,
    Position,
    Side,
)


def test_instrument_identifier() -> None:
    instrument = Instrument(
        symbol="NIFTY",
        exchange="NSE",
        instrument_type=InstrumentType.INDEX,
    )

    assert instrument.identifier == "NSE:NIFTY:INDEX"


def test_valid_candle() -> None:
    candle = Candle(
        timestamp=datetime.now(),
        open=25000,
        high=25100,
        low=24900,
        close=25050,
        volume=100000,
    )

    assert candle.close == 25050


def test_invalid_candle_high_low() -> None:
    with pytest.raises(ValueError):
        Candle(
            timestamp=datetime.now(),
            open=25000,
            high=24900,
            low=25000,
            close=24950,
        )


def test_order_quantity_validation() -> None:
    instrument = Instrument(
        symbol="NIFTY",
        exchange="NSE",
        instrument_type=InstrumentType.INDEX,
    )

    with pytest.raises(ValueError):
        Order(
            order_id="ORD-001",
            instrument=instrument,
            side=Side.BUY,
            quantity=0,
        )


def test_position_market_value() -> None:
    instrument = Instrument(
        symbol="NIFTY",
        exchange="NSE",
        instrument_type=InstrumentType.INDEX,
    )

    position = Position(
        instrument=instrument,
        quantity=10,
        average_price=25000,
    )

    assert position.market_value == 250000
